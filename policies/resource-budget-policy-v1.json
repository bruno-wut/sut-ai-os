{
  "schemaVersion": "1.0.0",
  "policyId": "resource-budget-policy-v1",
  "resourceDimensions": [
    { "resourceDimension": "worker_requests", "unit": "requests" },
    { "resourceDimension": "worker_cpu_milliseconds", "unit": "milliseconds" },
    { "resourceDimension": "queue_operations", "unit": "operations" },
    { "resourceDimension": "workflow_steps", "unit": "steps" },
    { "resourceDimension": "persistence_size_bytes", "unit": "bytes" },
    { "resourceDimension": "persistence_growth_bytes", "unit": "bytes" },
    { "resourceDimension": "persistence_egress_bytes", "unit": "bytes" },
    { "resourceDimension": "runner_minutes", "unit": "minutes" },
    { "resourceDimension": "ai_invocations", "unit": "invocations" },
    { "resourceDimension": "ai_tokens", "unit": "tokens" },
    { "resourceDimension": "notification_messages", "unit": "messages" }
  ],
  "thresholdBasisPoints": {
    "warning50": 5000,
    "warning75": 7500,
    "warning90": 9000,
    "hardLimit": 10000
  },
  "budgetStates": [
    "below_warning",
    "warning_50",
    "warning_75",
    "warning_90",
    "hard_limit_reached",
    "hard_limit_exceeded"
  ],
  "meterStates": [
    "fresh",
    "missing",
    "unavailable",
    "stale",
    "inconsistent",
    "uncertain",
    "unknown"
  ],
  "budgetAuthorityStates": [
    "available",
    "missing",
    "unavailable",
    "inconsistent",
    "unknown"
  ],
  "configurationStates": [
    "valid",
    "missing",
    "unsupported",
    "inconsistent",
    "unknown"
  ],
  "workloadZones": ["staff_control", "ai_workload"],
  "decisionOutcomes": [
    "continue_candidate",
    "warn_continue_candidate",
    "throttle_candidate",
    "pause_candidate",
    "requeue_candidate",
    "block_candidate"
  ],
  "workloadCeilings": {
    "maxBatchSize": 500,
    "maxRateLimitPerMinute": 1000,
    "maxConcurrency": 8,
    "maxRetryLimit": 3,
    "maxMeterAgeSeconds": 300
  },
  "decisionRules": {
    "below_warning": "continue_candidate",
    "warning_50": "warn_continue_candidate",
    "warning_75": "throttle_candidate",
    "warning_90_safe_requeue": "requeue_candidate",
    "warning_90_default": "pause_candidate",
    "hard_limit_reached": "block_candidate",
    "hard_limit_exceeded": "block_candidate",
    "invalid_boundary_or_workload": "block_candidate",
    "uncertain_safe_requeue": "requeue_candidate",
    "uncertain_default": "pause_candidate"
  },
  "bookingIsolation": {
    "bookingWorkload": false,
    "sharesQuotaWithBooking": false,
    "sharesCredentialsWithBooking": false,
    "sharesDeploymentWithBooking": false,
    "sharesFailureBoundaryWithBooking": false
  },
  "reasonPrecedence": [
    "INTERNAL_AUTHORITY_UNAVAILABLE",
    "CALLER_AUTHORITY_INJECTION",
    "MALFORMED_OBSERVATION",
    "UNSUPPORTED_SCHEMA_VERSION",
    "UNKNOWN_RESOURCE_DIMENSION",
    "UNIT_MISMATCH",
    "UNSUPPORTED_WORKLOAD_ZONE",
    "BOOKING_WORKLOAD_PROHIBITED",
    "BOOKING_QUOTA_BOUNDARY_VIOLATION",
    "BOOKING_CREDENTIAL_BOUNDARY_VIOLATION",
    "BOOKING_DEPLOYMENT_BOUNDARY_VIOLATION",
    "BOOKING_FAILURE_BOUNDARY_VIOLATION",
    "BUDGET_AUTHORITY_MISSING",
    "BUDGET_AUTHORITY_UNAVAILABLE",
    "BUDGET_AUTHORITY_INCONSISTENT",
    "BUDGET_AUTHORITY_UNKNOWN",
    "CONFIGURATION_MISSING",
    "UNSUPPORTED_CONFIGURATION",
    "CONFIGURATION_INCONSISTENT",
    "CONFIGURATION_UNKNOWN",
    "METER_MISSING",
    "METER_UNAVAILABLE",
    "METER_STALE",
    "METER_INCONSISTENT",
    "METER_UNCERTAIN",
    "METER_UNKNOWN",
    "METRIC_MISSING",
    "HARD_LIMIT_MISSING",
    "METERING_TIMESTAMP_MISSING",
    "METER_AGE_INVALID",
    "UNBOUNDED_BATCHING",
    "DEDUPLICATION_REQUIRED",
    "IDEMPOTENCY_REQUIRED",
    "BACKPRESSURE_REQUIRED",
    "RATE_LIMIT_REQUIRED",
    "CONCURRENCY_LIMIT_REQUIRED",
    "RETRY_LIMIT_REQUIRED",
    "RETRY_ATTEMPT_INVALID",
    "DEAD_LETTER_HANDLING_REQUIRED",
    "PRIORITY_QUEUE_REQUIRED",
    "CONTINUOUS_OR_PER_EVENT_SUMMARY_PROHIBITED",
    "PER_INTERACTION_WORK_PROHIBITED",
    "PER_EVENT_AI_INVOCATION_PROHIBITED",
    "WORKLOAD_CEILING_EXCEEDED",
    "SELF_AUTHORIZATION_CLAIM",
    "PRODUCTION_WRITE_CLAIM"
  ],
  "authority": {
    "nonAuthoritative": true,
    "schedulingAuthorized": false,
    "executionAuthorized": false,
    "notificationAuthorized": false,
    "productionWriteAuthorized": false,
    "capacityReservationAuthorized": false,
    "bookingEffectAuthorized": false
  }
}
