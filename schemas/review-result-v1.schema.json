{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/review-result-v1.schema.json",
  "title": "Sri U-Thong AI OS SHA-bound Review Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "baseSha",
    "headSha",
    "reviewerAgent",
    "model",
    "reasoningEffort",
    "contextManifestHash",
    "reviewedAt",
    "stage",
    "runId",
    "tracePath",
    "outputHash",
    "decision",
    "blockingFindings",
    "nonBlockingRisks",
    "missingNegativeTests",
    "architectureAssessment",
    "exactNextAction"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "headSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "reviewerAgent": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "contextManifestHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "stage": { "enum": ["planReview", "semanticReview", "mergeRiskReview"] },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "tracePath": { "type": "string", "pattern": "^artifacts/traces/codex-routing/" },
    "outputHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "decision": { "enum": ["pass", "revision-required", "blocked"] },
    "blockingFindings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonBlockingRisks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missingNegativeTests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "architectureAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deepModules", "hexagonalArchitecture", "eventedBoundaries"],
      "properties": {
        "deepModules": { "type": "string", "minLength": 1 },
        "hexagonalArchitecture": { "type": "string", "minLength": 1 },
        "eventedBoundaries": { "type": "string", "minLength": 1 }
      }
    },
    "exactNextAction": { "type": "string", "minLength": 1 }
  }
}
