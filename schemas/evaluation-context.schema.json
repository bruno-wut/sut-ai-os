{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/evaluation-context.schema.json",
  "title": "Evaluation Context Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "principalClass",
    "resourceClass",
    "targetAction",
    "dataClassification",
    "tenantScopeRequired"
  ],
  "properties": {
    "principalClass": {
      "type": "string",
      "minLength": 1
    },
    "resourceClass": {
      "type": "string",
      "minLength": 1
    },
    "targetAction": {
      "type": "string",
      "enum": [
        "read_only_platform_inspection",
        "governed_configuration_change",
        "production_write_operation"
      ]
    },
    "dataClassification": {
      "type": "string",
      "enum": [
        "public",
        "confidential",
        "restricted",
        "guest_pii",
        "payment_metadata"
      ]
    },
    "tenantScopeRequired": {
      "type": "boolean"
    }
  }
}
