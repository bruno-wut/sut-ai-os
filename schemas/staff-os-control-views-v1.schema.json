{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/staff-os-control-views-v1.schema.json",
  "title": "Staff OS Control Views V1 Observe-Only Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "viewSetId", "mode", "productionWritePermission", "views"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "viewSetId": { "const": "sut-aios-staff-os-control-views" },
    "mode": { "const": "observe-only" },
    "productionWritePermission": { "const": false },
    "views": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewId", "title", "source", "displayFields", "permittedActions", "noLiveDataState"],
          "properties": {
            "viewId": { "const": "workflow-control-plane" },
            "title": { "const": "Workflow control-plane" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorityPath", "authorityType", "entity"],
              "properties": {
                "authorityPath": { "const": "packages/control-plane-schema/control-plane-schema-v1.json" },
                "authorityType": { "const": "static_control_plane_contract" },
                "entity": { "const": "workflow_runs" }
              }
            },
            "displayFields": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [{ "const": "id" }, { "const": "correlationId" }, { "const": "status" }, { "const": "triggerEventId" }],
              "items": false
            },
            "permittedActions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [{ "const": "observe" }],
              "items": false
            },
            "noLiveDataState": { "const": "static_contract_only" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewId", "title", "source", "displayFields", "permittedActions", "noLiveDataState"],
          "properties": {
            "viewId": { "const": "append-only-audit-record" },
            "title": { "const": "Append-only audit record" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorityPath", "authorityType", "entity"],
              "properties": {
                "authorityPath": { "const": "packages/audit-sdk/append-only-audit-contract-v1.json" },
                "authorityType": { "const": "static_append_only_audit_contract" },
                "entity": { "const": "record" }
              }
            },
            "displayFields": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "prefixItems": [{ "const": "id" }, { "const": "correlationId" }, { "const": "recordedAt" }, { "const": "actorType" }, { "const": "actionType" }, { "const": "outcome" }],
              "items": false
            },
            "permittedActions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [{ "const": "observe" }],
              "items": false
            },
            "noLiveDataState": { "const": "static_contract_only" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["viewId", "title", "source", "displayFields", "permittedActions", "noLiveDataState"],
          "properties": {
            "viewId": { "const": "deny-only-kill-switch-decision" },
            "title": { "const": "Deny-only kill-switch decision" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authorityPath", "authorityType", "publicInterface", "fixedRequest", "expectedDecision"],
              "properties": {
                "authorityPath": { "const": "services/orchestrator/src/kill-switch/evaluator.mjs" },
                "authorityType": { "const": "deny_only_kill_switch_evaluator" },
                "publicInterface": { "const": "evaluateKillSwitch" },
                "fixedRequest": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["targetAction"],
                  "properties": { "targetAction": { "const": "observe" } }
                },
                "expectedDecision": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schemaVersion", "decision", "reasonCode", "controlId"],
                  "properties": {
                    "schemaVersion": { "const": "1.0.0" },
                    "decision": { "const": "deny" },
                    "reasonCode": { "const": "KILL_SWITCH_NO_MATCH_FAIL_CLOSED" },
                    "controlId": { "const": null }
                  }
                }
              }
            },
            "displayFields": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [{ "const": "schemaVersion" }, { "const": "decision" }, { "const": "reasonCode" }, { "const": "controlId" }],
              "items": false
            },
            "permittedActions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [{ "const": "observe" }],
              "items": false
            },
            "noLiveDataState": { "const": "static_contract_only" }
          }
        }
      ],
      "items": false
    }
  }
}
