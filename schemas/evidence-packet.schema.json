{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/evidence-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "recordedAt", "preparedBy", "summary", "checks", "artifacts", "risks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "taskId": { "type": "string" }, "recordedAt": { "type": "string", "format": "date-time" }, "preparedBy": { "type": "string" }, "summary": { "type": "string", "maxLength": 4000 },
    "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "result", "reference"], "properties": { "name": { "type": "string" }, "result": { "enum": ["pass", "fail", "blocked", "not-run"] }, "reference": { "type": "string" } } } },
    "artifacts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["reference", "description"], "properties": { "reference": { "type": "string" }, "description": { "type": "string", "maxLength": 1000 }, "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }, "mediaType": { "type": "string" } } } },
    "risks": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
  }
}
