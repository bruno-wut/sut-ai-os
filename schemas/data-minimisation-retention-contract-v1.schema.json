{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/data-minimisation-retention-contract-v1.schema.json",
  "title": "Data Minimisation and Retention Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "rawSourceOnlyCategories", "aiOsEligibleCategories", "artifactClasses", "aggregationIntervals", "actionCandidates", "categoryRules", "workloadRules", "retentionRules", "reasonPrecedence", "authority"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "policyId": { "const": "data-minimisation-retention-policy-v1" },
    "rawSourceOnlyCategories": { "const": ["raw_page_view", "raw_click", "raw_scroll", "raw_marketing_telemetry"] },
    "aiOsEligibleCategories": { "const": ["hourly_analytics_aggregate", "daily_analytics_aggregate", "essential_booking_lifecycle_event", "anomaly", "incident", "investigation", "recommendation", "intervention_proposal", "approval", "execution", "outcome", "required_audit_evidence"] },
    "artifactClasses": { "const": ["source_system_managed", "temporary_ingestion_record", "debug_log", "ai_prompt", "ai_output", "workflow_execution_detail", "analytics_aggregate", "booking_lifecycle_record", "incident_record", "audit_evidence"] },
    "aggregationIntervals": { "const": ["source_only", "hourly", "daily", "not_applicable"] },
    "actionCandidates": { "const": ["retain_at_source", "aggregate", "scheduled_delete", "archive", "transfer_eligible", "retain"] },
    "categoryRules": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/categoryRule" } },
    "workloadRules": { "$ref": "#/$defs/workloadRules" },
    "retentionRules": { "$ref": "#/$defs/retentionRules" },
    "reasonPrecedence": { "const": ["INTERNAL_AUTHORITY_UNAVAILABLE", "CALLER_AUTHORITY_INJECTION", "MALFORMED_CANDIDATE", "UNSUPPORTED_SCHEMA_VERSION", "UNKNOWN_DATA_CATEGORY", "UNKNOWN_SOURCE_CLASS", "UNKNOWN_ARTIFACT_CLASS", "RAW_TELEMETRY_SOURCE_BOUNDARY_VIOLATION", "PROHIBITED_PER_INTERACTION_PERSISTENCE", "PROHIBITED_PER_INTERACTION_QUEUE", "PROHIBITED_PER_INTERACTION_WORKFLOW", "PROHIBITED_PER_INTERACTION_AI_INVOCATION", "PROHIBITED_PER_EVENT_AI_INVOCATION", "AGGREGATION_INTERVAL_MISMATCH", "CATEGORY_SOURCE_MISMATCH", "CATEGORY_ARTIFACT_MISMATCH", "RETENTION_ACTION_NOT_ELIGIBLE", "PROTECTED_HISTORY_CONFLICT", "APPEND_ONLY_AUDIT_CONFLICT", "FAILED_ATTEMPT_HISTORY_CONFLICT", "SELF_AUTHORIZATION_CLAIM", "PRODUCTION_WRITE_CLAIM"] },
    "authority": { "$ref": "#/$defs/policyAuthority" }
  },
  "$defs": {
    "categoryRule": {
      "type": "object", "additionalProperties": false,
      "required": ["dataCategory", "sourceClass", "artifactClasses", "aggregationInterval", "storageClasses", "actionCandidates", "eligibility"],
      "properties": {
        "dataCategory": { "$ref": "#/$defs/dataCategory" }, "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "artifactClasses": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactClass" } },
        "aggregationInterval": { "$ref": "#/$defs/aggregationInterval" },
        "storageClasses": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/storageClass" } },
        "actionCandidates": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/actionCandidate" } },
        "eligibility": { "$ref": "#/$defs/eligibility" }
      }
    },
    "workloadRules": {
      "type": "object", "additionalProperties": false,
      "required": ["perInteractionPermanentRowAllowed", "perInteractionQueueAllowed", "perInteractionWorkflowAllowed", "perInteractionAiInvocationAllowed", "perSystemEventAiInvocationAllowed", "scheduledSummaryOrGovernedCaseOnly"],
      "properties": {
        "perInteractionPermanentRowAllowed": { "const": false }, "perInteractionQueueAllowed": { "const": false },
        "perInteractionWorkflowAllowed": { "const": false }, "perInteractionAiInvocationAllowed": { "const": false },
        "perSystemEventAiInvocationAllowed": { "const": false }, "scheduledSummaryOrGovernedCaseOnly": { "const": true }
      }
    },
    "retentionRules": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibilityMode", "configuredDurationIncluded", "dueStateEvaluated", "legalComplianceEstablished", "protectedHistoryActions"],
      "properties": {
        "eligibilityMode": { "const": "future_lifecycle_candidate_only" }, "configuredDurationIncluded": { "const": false },
        "dueStateEvaluated": { "const": false }, "legalComplianceEstablished": { "const": false },
        "protectedHistoryActions": { "const": ["archive", "transfer_eligible", "retain"] }
      }
    },
    "policyAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["nonAuthoritative", "classificationAuthorizesPersistence", "classificationAuthorizesLifecycleAction", "classificationAuthorizesAiInvocation", "classificationEstablishesCompliance", "productionWriteGranted"],
      "properties": {
        "nonAuthoritative": { "const": true }, "classificationAuthorizesPersistence": { "const": false },
        "classificationAuthorizesLifecycleAction": { "const": false }, "classificationAuthorizesAiInvocation": { "const": false },
        "classificationEstablishesCompliance": { "const": false }, "productionWriteGranted": { "const": false }
      }
    },
    "dataCategory": { "enum": ["raw_page_view", "raw_click", "raw_scroll", "raw_marketing_telemetry", "hourly_analytics_aggregate", "daily_analytics_aggregate", "essential_booking_lifecycle_event", "anomaly", "incident", "investigation", "recommendation", "intervention_proposal", "approval", "execution", "outcome", "required_audit_evidence"] },
    "sourceClass": { "enum": ["analytics_source", "booking_control_plane", "ai_os_control_plane", "repository_evidence"] },
    "artifactClass": { "enum": ["source_system_managed", "temporary_ingestion_record", "debug_log", "ai_prompt", "ai_output", "workflow_execution_detail", "analytics_aggregate", "booking_lifecycle_record", "incident_record", "audit_evidence"] },
    "aggregationInterval": { "enum": ["source_only", "hourly", "daily", "not_applicable"] },
    "actionCandidate": { "enum": ["retain_at_source", "aggregate", "scheduled_delete", "archive", "transfer_eligible", "retain"] },
    "storageClass": { "enum": ["source_system_only", "temporary_ai_os", "durable_ai_os"] },
    "eligibility": { "enum": ["source_only", "future_lifecycle_candidate", "protected_preservation_only"] },
    "handlingIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["storage", "queue", "workflow", "aiInvocation", "onePermanentRowPerInteraction"],
      "properties": {
        "storage": { "$ref": "#/$defs/storageClass" },
        "queue": { "enum": ["none", "batched_aggregate_or_lifecycle", "individual_guest_interaction"] },
        "workflow": { "enum": ["none", "scheduled_summary_or_governed_case", "individual_guest_interaction"] },
        "aiInvocation": { "enum": ["none", "scheduled_summary_or_governed_case", "individual_guest_interaction", "individual_system_event"] },
        "onePermanentRowPerInteraction": { "type": "boolean" }
      }
    },
    "historyProtection": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "originalRecordPreserved", "failedAttemptHistoryPreserved", "rewriteRequested"],
      "properties": {
        "kind": { "enum": ["none", "append_only_audit", "failed_attempt_history"] },
        "originalRecordPreserved": { "type": "boolean" }, "failedAttemptHistoryPreserved": { "type": "boolean" }, "rewriteRequested": { "type": "boolean" }
      }
    },
    "candidateAuthorityClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["callerSuppliesAuthority", "classificationAuthorizesPersistence", "classificationAuthorizesLifecycleAction", "classificationAuthorizesAiInvocation", "productionWriteGranted"],
      "properties": {
        "callerSuppliesAuthority": { "const": false }, "classificationAuthorizesPersistence": { "const": false },
        "classificationAuthorizesLifecycleAction": { "const": false }, "classificationAuthorizesAiInvocation": { "const": false },
        "productionWriteGranted": { "const": false }
      }
    },
    "dataGovernanceCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "candidateId", "dataCategory", "sourceClass", "artifactClass", "aggregationInterval", "requestedAction", "handlingIntent", "historyProtection", "authorityClaims"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "candidateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "dataCategory": { "$ref": "#/$defs/dataCategory" }, "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "artifactClass": { "$ref": "#/$defs/artifactClass" }, "aggregationInterval": { "$ref": "#/$defs/aggregationInterval" },
        "requestedAction": { "$ref": "#/$defs/actionCandidate" }, "handlingIntent": { "$ref": "#/$defs/handlingIntent" },
        "historyProtection": { "$ref": "#/$defs/historyProtection" }, "authorityClaims": { "$ref": "#/$defs/candidateAuthorityClaims" }
      }
    },
    "acceptedValue": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "candidate", "eligibility", "nonAuthoritative", "actionAuthorized", "productionWriteAuthorized"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }, "candidate": { "$ref": "#/$defs/dataGovernanceCandidate" },
        "eligibility": { "$ref": "#/$defs/eligibility" }, "nonAuthoritative": { "const": true },
        "actionAuthorized": { "const": false }, "productionWriteAuthorized": { "const": false }
      }
    },
    "reasonCode": { "enum": ["INTERNAL_AUTHORITY_UNAVAILABLE", "CALLER_AUTHORITY_INJECTION", "MALFORMED_CANDIDATE", "UNSUPPORTED_SCHEMA_VERSION", "UNKNOWN_DATA_CATEGORY", "UNKNOWN_SOURCE_CLASS", "UNKNOWN_ARTIFACT_CLASS", "RAW_TELEMETRY_SOURCE_BOUNDARY_VIOLATION", "PROHIBITED_PER_INTERACTION_PERSISTENCE", "PROHIBITED_PER_INTERACTION_QUEUE", "PROHIBITED_PER_INTERACTION_WORKFLOW", "PROHIBITED_PER_INTERACTION_AI_INVOCATION", "PROHIBITED_PER_EVENT_AI_INVOCATION", "AGGREGATION_INTERVAL_MISMATCH", "CATEGORY_SOURCE_MISMATCH", "CATEGORY_ARTIFACT_MISMATCH", "RETENTION_ACTION_NOT_ELIGIBLE", "PROTECTED_HISTORY_CONFLICT", "APPEND_ONLY_AUDIT_CONFLICT", "FAILED_ATTEMPT_HISTORY_CONFLICT", "SELF_AUTHORIZATION_CLAIM", "PRODUCTION_WRITE_CLAIM"] },
    "rejection": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "failClosed", "reasonCodes"],
      "properties": { "schemaVersion": { "const": "1.0.0" }, "failClosed": { "const": true }, "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reasonCode" } } }
    },
    "classificationDecision": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["ok", "value", "rejection"], "properties": { "ok": { "const": true }, "value": { "$ref": "#/$defs/acceptedValue" }, "rejection": { "type": "null" } } },
        { "type": "object", "additionalProperties": false, "required": ["ok", "value", "rejection"], "properties": { "ok": { "const": false }, "value": { "type": "null" }, "rejection": { "$ref": "#/$defs/rejection" } } }
      ]
    }
  }
}
