{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sut-ai-os.local/schemas/normalized-system-event/1.0.0",
  "title": "Normalized System Event",
  "description": "Static version 1 interoperability envelope; it does not define delivery or authorization semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "correlationId",
    "source",
    "type",
    "severity",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "component"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 }
      }
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "severity": {
      "enum": ["info", "warning", "error", "critical"]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
