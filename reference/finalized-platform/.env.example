# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public legal document versions shown at checkout and on policy pages
NEXT_PUBLIC_LEGAL_TERMS_VERSION=2026-06-01
NEXT_PUBLIC_LEGAL_PRIVACY_POLICY_VERSION=2026-06-01
NEXT_PUBLIC_LEGAL_CANCELLATION_POLICY_VERSION=2026-06-01
HOTEL_TIME_ZONE=Asia/Bangkok

# Server-only Supabase access; never prefix this key with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HOTEL_ID=your-hotel-uuid

# Direct PostgreSQL URLs are not used by the Next.js Supabase clients.
# If future maintenance tooling uses a PostgreSQL driver, use Transaction mode
# on port 6543 and keep the value server-only.
SUPABASE_TRANSACTION_POOLER_URL_6543=postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres

# Keep inventory mutations disabled until production data and Cloudflare rate
# limiting are verified.
CHECKOUT_HOLD_LIVE_ENABLED=false

# Cloudflare Images direct creator uploads
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_IMAGES_ACCOUNT_HASH=replace-with-imagedelivery-account-hash
CLOUDFLARE_IMAGES_API_TOKEN=replace-with-cloudflare-images-token

# Stripe Checkout and webhook verification
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional public HTTPS wordmark override for Stripe-hosted Checkout. Stripe
# must be able to fetch this URL without authentication.
STRIPE_CHECKOUT_LOGO_URL=https://cdn.example.com/sri-u-thong-wordmark.png

# Scheduled operations and leased notification worker authentication
CRON_SECRET=replace-with-a-high-entropy-secret
STAGING_PREVIEW_USERNAME=preview
STAGING_PREVIEW_PASSWORD=replace-with-a-high-entropy-preview-password

# Transactional email through Resend
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-signing-secret
EMAIL_FROM=Sri U-Thong Grand Hotel <reservations@example.com>
EMAIL_REPLY_TO=frontdesk@example.com

# Optional management webhook/SMS delivery endpoint
MANAGEMENT_NOTIFICATION_WEBHOOK_URL=https://example.com/management-alerts
MANAGEMENT_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-high-entropy-secret
