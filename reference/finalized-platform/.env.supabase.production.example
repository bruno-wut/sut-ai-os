# Supabase production configuration
# Copy these values into encrypted local or Cloudflare environment variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://secure.sriuthonghotels.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HOTEL_ID=your-hotel-uuid

# Keep checkout mutations disabled until Cloudflare rate limiting is active.
CHECKOUT_HOLD_LIVE_ENABLED=false

# Optional direct database access for maintenance tooling only.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_TRANSACTION_POOLER_URL_6543=postgresql://postgres.your-project:password@region.pooler.supabase.com:6543/postgres
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-signing-secret
EMAIL_FROM=Sri U-Thong Grand Hotel <reservations@mail.sriuthong.com>
EMAIL_REPLY_TO=frontdesk@sriuthonghotels.com
CRON_SECRET=replace-with-a-high-entropy-secret
