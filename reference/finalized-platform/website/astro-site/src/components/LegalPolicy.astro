---
import BaseLayout from "../layouts/BaseLayout.astro";

const { title } = Astro.props;
---

<BaseLayout title={title} canonicalPath={Astro.url.pathname.replace(/^\/(en|th)/, "") || "/"} headerVariant="solid">
  <section class="legal-policy">
    <div class="legal-policy__inner">
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .legal-policy { padding: 8rem 1.5rem 5rem; background: var(--color-paper); }
  .legal-policy__inner { max-width: 820px; margin: 0 auto; }
  .legal-policy article { color: var(--color-ink); line-height: 1.82; font-size: 1.05rem; }
  
  /* Official legal styling rules */
  .legal-policy article h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.5rem); margin-top: 0; margin-bottom: 1.5rem; color: var(--color-charcoal); font-weight: 500; }
  .legal-policy article h2 { font-family: var(--font-serif); font-size: clamp(1.4rem, 3vw, 1.75rem); margin-top: 2.2rem; margin-bottom: 1rem; color: var(--color-charcoal); border-bottom: 1px solid rgba(164, 129, 67, 0.24); padding-bottom: 0.5rem; font-weight: 500; }
  .legal-policy article h3 { font-family: var(--font-serif); font-size: clamp(1.15rem, 2vw, 1.35rem); margin-top: 1.8rem; margin-bottom: 0.75rem; color: var(--color-charcoal); font-weight: 500; }
  .legal-policy article p { margin-top: 0; margin-bottom: 1.25rem; color: var(--color-ink); text-align: justify; }
  .legal-policy article ul, .legal-policy article ol { margin-top: 0; margin-bottom: 1.25rem; padding-left: 1.5rem; }
  .legal-policy article li { margin-bottom: 0.5rem; }
  .legal-policy article strong { color: var(--color-charcoal); font-weight: 600; }
</style>
