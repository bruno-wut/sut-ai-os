---
import CloudflareImage from "./CloudflareImage.astro";

const { image = null, alt, eyebrow, title, text, href, cta = "Learn More" } = Astro.props;
const cardImage = typeof image === "string" ? { src: image } : (image ?? {});
const cardImageAlt = alt ?? cardImage.alt ?? "";
---

<article class="media-card">
  <a class="image-frame media-card__image" href={href}>
    <CloudflareImage
      class="w-full max-w-full h-auto"
      src={cardImage.src}
      alt={cardImageAlt}
      widths={[360, 540, 720, 960]}
      sizes="(max-width: 720px) 100vw, 33vw"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="media-card__body break-words">
    {eyebrow && <p class="eyebrow leading-relaxed">{eyebrow}</p>}
    <h3 class="leading-[1.5]">{title}</h3>
    <p class="leading-relaxed">{text}</p>
    {href && <a class="text-link" href={href}>{cta}</a>}
  </div>
</article>
