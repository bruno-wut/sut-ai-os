---
import LegalPolicy from "../../components/LegalPolicy.astro";
import EnContent from "../../../../../docs/privacy_policy_final.md";
import ThContent from "../../../../../docs/privacy_policy_thai.md";

export function getStaticPaths() { return ["en", "th"].map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale;
---
<LegalPolicy title={locale === "th" ? "นโยบายความเป็นส่วนตัว | โรงแรมศรีอู่ทอง แกรนด์" : "PDPA Privacy Policy | Sri U-Thong Grand Hotel"}>
  {locale === "th" ? <ThContent /> : <EnContent />}
</LegalPolicy>
