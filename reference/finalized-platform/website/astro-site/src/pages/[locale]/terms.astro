---
import LegalPolicy from "../../components/LegalPolicy.astro";
import EnContent from "../../../../../docs/sri-u-thong-grand-hotel-booking-terms-v1.5.md";
import ThContent from "../../../../../docs/sri-u-thong-grand-hotel-booking-terms-v1.5-th.md";

export function getStaticPaths() { return ["en", "th"].map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale;
---
<LegalPolicy title={locale === "th" ? "เงื่อนไขการจอง | โรงแรมศรีอู่ทอง แกรนด์" : "Booking Terms | Sri U-Thong Grand Hotel"}>
  {locale === "th" ? <ThContent /> : <EnContent />}
</LegalPolicy>
