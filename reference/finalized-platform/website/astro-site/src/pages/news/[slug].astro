---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CloudflareImage from "../../components/CloudflareImage.astro";
import { getNewsPosts } from "../../data/newsCollection.js";
import { getLocale, withLocale } from "../../data/locale.js";
import { getAstroCopy } from "../../data/siteCopy.js";
import { astroSiteConfig } from "../../data/siteConfig.js";

export async function getStaticPaths() {
  const posts = await getNewsPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const locale = getLocale(Astro.url);
const copy = getAstroCopy(locale);
const bookingBaseUrl = import.meta.env.PUBLIC_BOOKING_URL ?? astroSiteConfig.bookingSiteUrl;
const bookingUrl = `${bookingBaseUrl}/${locale}/book`;
const articleUrl = new URL(withLocale(`/news/${post.id}/`, locale), astroSiteConfig.canonicalSiteUrl).toString();
const dateFormatter = new Intl.DateTimeFormat(copy.site.localeArticleDate, {
  month: "long",
  day: "numeric",
  year: "numeric"
});
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.coverImage,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: post.data.publishDate.toISOString(),
  author: {
    "@type": "Organization",
    name: post.data.author
  },
  publisher: {
    "@type": "Organization",
    name: "Sri U-Thong Grand Hotel"
  },
  mainEntityOfPage: articleUrl,
  keywords: post.data.tags.join(", ")
};
---

<BaseLayout
  title={`${post.data.title} | Sri U-Thong Grand Hotel`}
  description={post.data.excerpt}
  image={post.data.coverImage}
  canonicalPath={`/news/${post.id}/`}
  headerVariant="solid"
>
  <article class="news-article">
    <header class="news-article__header">
      <div class="container news-article__heading">
        <a class="text-link" href={withLocale("/news/", locale)}>{copy.newsArticle.allNews}</a>
        <p class="news-card__meta">
          <time datetime={post.data.publishDate.toISOString()}>{dateFormatter.format(post.data.publishDate)}</time>
          <span>{post.data.author}</span>
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.excerpt}</p>
        {post.data.tags.length > 0 && (
          <ul class="news-tags" aria-label={copy.latestNews.tagsAria}>
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
      <figure class="news-article__cover">
        <CloudflareImage
          src={post.data.coverImage}
          alt={copy.latestNews.coverAlt(post.data.title)}
          widths={[800, 1200, 1600]}
          width={1200}
          sizes="100vw"
          loading="eager"
        />
      </figure>
    </header>

    <div class="container news-article__body">
      <div class="prose news-prose">
        <Content />
      </div>

      <aside class="news-article__cta" aria-label={copy.newsArticle.stayButton}>
        <p class="eyebrow">{copy.newsArticle.stayEyebrow}</p>
        <h2>{copy.newsArticle.stayTitle}</h2>
        <p>{copy.newsArticle.stayText}</p>
        <a class="button" href={bookingUrl}>{copy.newsArticle.stayButton}</a>
      </aside>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
