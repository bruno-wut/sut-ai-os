---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CloudflareImage from "../../components/CloudflareImage.astro";
import { getNewsPosts } from "../../data/newsCollection.js";
import { getLocale, withLocale } from "../../data/locale.js";
import { getAstroCopy } from "../../data/siteCopy.js";

const locale = getLocale(Astro.url);
const copy = getAstroCopy(locale);
const posts = await getNewsPosts();

const dateFormatter = new Intl.DateTimeFormat(copy.site.localeArticleDate, {
  month: "long",
  day: "numeric",
  year: "numeric"
});
---

<BaseLayout
  title={copy.newsIndex.meta.title}
  description={copy.newsIndex.meta.description}
  canonicalPath="/news/"
  headerVariant="solid"
>
  <section class="news-ledger-hero">
    <div class="container news-ledger-hero__inner">
      <p class="eyebrow">{copy.newsIndex.hero.eyebrow}</p>
      <h1>{copy.newsIndex.hero.title}</h1>
      <p class="lead">{copy.newsIndex.hero.lead}</p>
    </div>
  </section>

  <section class="section news-index-section" aria-labelledby="news-index-title">
    <div class="container news-index">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.newsIndex.section.eyebrow}</p>
          <h2 id="news-index-title">{copy.newsIndex.section.title}</h2>
        </div>
        <p class="lead">{copy.newsIndex.section.lead}</p>
      </div>

      {posts.length > 0 ? (
        <div class="news-index__list">
          {posts.map((post) => (
            <article class="news-index-item">
              <a class="news-index-item__image" href={withLocale(`/news/${post.id}/`, locale)} aria-label={copy.latestNews.articleLinkAria(post.data.title)}>
                <CloudflareImage
                  src={post.data.coverImage}
                  alt={copy.latestNews.coverAlt(post.data.title)}
                  widths={[480, 800, 1200]}
                  width={800}
                  sizes="(max-width: 860px) 100vw, 360px"
                />
              </a>
              <div class="news-index-item__body">
                <p class="news-card__meta">
                  <time datetime={post.data.publishDate.toISOString()}>{dateFormatter.format(post.data.publishDate)}</time>
                  <span>{post.data.author}</span>
                </p>
                <h3><a href={withLocale(`/news/${post.id}/`, locale)}>{post.data.title}</a></h3>
                <p>{post.data.excerpt}</p>
                {post.data.tags.length > 0 && (
                  <ul class="news-tags" aria-label={copy.latestNews.tagsAria}>
                    {post.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
                <a class="text-link" href={withLocale(`/news/${post.id}/`, locale)}>{copy.latestNews.readArticle}</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="news-empty">
          <h3>{copy.newsIndex.empty.title}</h3>
          <p>{copy.newsIndex.empty.text}</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
