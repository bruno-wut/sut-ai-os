{
  "name": "sri-u-thong-hotel-inventory-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging -- --keep-vars",
    "deploy:cloudflare:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "verify:cloudflare-config": "opennextjs-cloudflare build && wrangler deploy --dry-run --config wrangler.jsonc",
    "start": "next start",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:migration-history": "node scripts/verify-migration-history.mjs",
    "verify:images": "node scripts/verify-image-architecture.mjs",
    "verify:images:remote": "node scripts/verify-image-architecture.mjs --remote",
    "test:allocation:concurrency": "node scripts/test-allocation-concurrency.mjs",
    "test:db": "node scripts/test-migrations.mjs",
    "test:db:baseline-010": "node scripts/test-migrations.mjs --baseline-010",
    "verify:storefront:metadata": "npm run build --prefix website/astro-site && node scripts/verify-storefront-output.mjs",
    "verify:storefront:freeze": "npm run build --prefix website/astro-site && node scripts/verify-storefront-output.mjs --require-content-freeze",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:8a": "playwright test tests/e2e/cross-browser-rendering.spec.ts",
    "test:e2e:storefront:8a": "playwright test --config playwright.storefront.config.ts tests/storefront-e2e/cross-browser-rendering.spec.ts",
    "test:e2e:storefront": "playwright test --config playwright.storefront.config.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.80.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@electric-sql/pglite": "^0.5.3",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^27.2.0",
    "lighthouse": "^13.4.0",
    "pg": "^8.22.0",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
